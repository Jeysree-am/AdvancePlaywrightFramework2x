{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SelfHealingSuggestion",
  "description": "Advisory locator-healing suggestion for a broken Playwright selector. Never applied to source files. Consumed by CustomReporter's Self-Healing tab.",
  "type": "object",
  "additionalProperties": false,
  "required": ["healable", "originalSelector", "confidence", "rationale"],
  "properties": {
    "healable": {
      "type": "boolean"
    },
    "originalSelector": {
      "type": "string",
      "minLength": 1
    },
    "healedSelector": {
      "description": "Omitted when healable is false.",
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
