{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FlakyResult",
  "description": "Build-vs-build flaky analysis. counts and flaky are computed deterministically; summary is the optional LLM-written prose. Consumed by CustomReporter's Flaky tab.",
  "type": "object",
  "additionalProperties": false,
  "required": ["counts", "flaky"],
  "properties": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flaky", "failing", "total"],
      "properties": {
        "flaky": { "type": "integer", "minimum": 0 },
        "failing": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "flaky": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
