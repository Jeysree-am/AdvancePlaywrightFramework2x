{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RcaVerdict",
  "description": "Root-cause verdict produced by the RCA agent for one failed test. Consumed by CustomReporter's AI Verdict tab.",
  "type": "object",
  "additionalProperties": false,
  "required": ["severity", "priority", "rootCause", "fixes"],
  "properties": {
    "severity": {
      "description": "Must match the reporter's .sev-* badge classes.",
      "type": "string",
      "enum": ["critical", "high", "medium", "low"]
    },
    "priority": {
      "type": "string",
      "minLength": 1
    },
    "rootCause": {
      "type": "string",
      "minLength": 1
    },
    "fixes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
