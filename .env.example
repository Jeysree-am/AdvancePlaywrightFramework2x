# Environment configuration - copy to .env and fill in your values
TTA_ENV=qa
BASE_URL=https://app.thetestingacademy.com
QA_BASE_URL=https://app.thetestingacademy.com
STG_BASE_URL=https://stage.thetestingacademy.com
PROD_BASE_URL=https://app.thetestingacademy.com
DEV_BASE_URL=http://localhost:3000
API_BASE_URL=https://restful-booker.herokuapp.com
LOG_LEVEL=info
TEST_ENV=QA
TEST_AUTHOR=your-name

# Credentials used by e2e-checkout-env.spec.ts (required - use valid TTACart users)
STANDARD_USER=standard_user
TTA_SECRET=tta_secret

# --- AI layer (agents under src/ai) -----------------------------------------
# Active provider: deepseek | openrouter | groq | commandcode
LLM_PROVIDER=commandcode
# Optional overrides for the active provider
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_WIRE=openai-completions
# Provider keys - set the one for your LLM_PROVIDER
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# command_api_key=
# COMMAND_CODE_BASE_URL=https://api.commandcode.ai/provider/v1
